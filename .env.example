# DeepSeek chat route
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_SUMMARY_MODEL=deepseek-v4-flash
# Keep the key outside the repository. Example for the local exercise environment:
# DEEPSEEK_API_KEY_FILE=D:\企业实训\api

# Optional OpenAI-compatible embedding route. DeepSeek chat does not expose embeddings.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY_FILE=D:\path\to\embedding-key

# Optional rerank route; vendor APIs differ, but the gateway uses /rerank.
# RERANK_BASE_URL=https://api.jina.ai/v1
# RERANK_MODEL=jina-reranker-v3
# RERANK_API_KEY_FILE=D:\path\to\rerank-key

MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_DELAY_MS=250
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_MS=10000
MODEL_MAX_RESPONSE_BYTES=4194304
MODEL_MAX_OUTPUT_TOKENS=8000

# Optional cost accounting, in currency units per one million tokens.
DEEPSEEK_INPUT_PRICE_PER_MILLION=0
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0
