NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=.data/codeharness.sqlite
WORKSPACE_ROOT=.data/workspaces
MAX_TASK_STEPS=20
MAX_COMMAND_TIMEOUT_MS=30000
MAX_COMMAND_OUTPUT_BYTES=1048576
MAX_READ_FILE_BYTES=1048576
MAX_TOOL_ARGUMENT_BYTES=262144
MAX_TOOL_OUTPUT_BYTES=1048576
TASK_LEASE_TTL_MS=15000
TASK_CONTROL_POLL_MS=250
MAX_MODEL_TIMEOUT_MS=30000
MAX_INDEX_TIMEOUT_MS=30000
MAX_TASK_DURATION_MS=900000
MAX_TASK_TOOL_CALLS=80
MAX_TASK_CHANGED_FILES=100
MAX_MODEL_INPUT_TOKENS=120000
MAX_MODEL_OUTPUT_TOKENS=16000
MAX_MODEL_COST=10
MAX_CONTEXT_BYTES=65536
MAX_CONTEXT_ENTRY_BYTES=16384
MAX_CONTEXT_ENTRIES=32
MAX_CONTEXT_HISTORY_MESSAGES=8
MAX_CONTEXT_READ_BYTES=262144
MAX_VERIFICATION_RUNS=3
MAX_CONSECUTIVE_HARNESS_FAILURES=3
MAX_IMPORT_FILES=20000
MAX_IMPORT_BYTES=536870912
MAX_FILE_BYTES=5242880
WORKSPACE_RETENTION_HOURS=168
WORKSPACE_PRUNE_INTERVAL_MS=3600000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SSE_REPLAY_INTERVAL_MS=1000
SSE_MAX_PENDING_EVENTS=1000
MOCK_MODE=true
VITE_API_BASE_URL=http://127.0.0.1:3000

# Model gateway
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_SUMMARY_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY_FILE=D:\path\to\deepseek-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY_FILE=D:\path\to\embedding-key
# RERANK_BASE_URL=https://api.jina.ai/v1
# RERANK_MODEL=jina-reranker-v3
# RERANK_API_KEY_FILE=D:\path\to\rerank-key
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_DELAY_MS=250
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_MS=10000
MODEL_MAX_RESPONSE_BYTES=4194304
MODEL_MAX_OUTPUT_TOKENS=8000
DEEPSEEK_INPUT_PRICE_PER_MILLION=0
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0
