{
  "name": "codeharness",
  "version": "0.1.0",
  "private": true,
  "description": "CodeHarness repository intelligence assistant",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx backend/src/server.ts",
    "dev:backend": "tsx backend/src/server.ts",
    "dev:frontend": "vite",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "start": "node dist/backend/src/server.js",
    "preview": "vite preview",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:frontend": "vitest run --config vite.config.ts",
    "test:watch": "vitest --config vitest.backend.config.ts",
    "lint": "eslint backend/src backend/test scripts src vite.config.ts vitest.backend.config.ts --max-warnings=0",
    "format:check": "prettier --check backend src docs schemas scripts *.json *.config.js *.config.ts README.md CONTRIBUTING.md index.html .github/workflows",
    "openapi:generate": "tsx scripts/openapi-contract.ts",
    "schema:check": "tsx scripts/validate-schemas.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run schema:check && npm test",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc -p tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
