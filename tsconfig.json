{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "backend/**/*.ts",
    "scripts/**/*.ts",
    "backend/test/**/*.ts",
    "vitest.backend.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src"]
}
