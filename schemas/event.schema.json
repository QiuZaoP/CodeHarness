{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeharness.local/schemas/event.schema.json",
  "title": "CodeHarness task event envelope",
  "type": "object",
  "required": ["schemaVersion", "id", "taskId", "type", "timestamp", "payload"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/schemaVersion"
    },
    "id": { "type": "integer", "minimum": 1 },
    "taskId": {
      "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/id"
    },
    "type": {
      "type": "string",
      "enum": [
        "task.created",
        "task.state_changed",
        "task.plan.updated",
        "tool.started",
        "tool.completed",
        "task.completed",
        "task.failed",
        "task.waiting_user",
        "task.paused",
        "task.resumed",
        "task.cancelled",
        "task.applied",
        "verification.completed",
        "change.updated"
      ]
    },
    "timestamp": {
      "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/timestamp"
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "task.created" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/taskCreatedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.state_changed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/stateChangedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.plan.updated" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/planUpdatedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "tool.started" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/toolStartedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "tool.completed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/toolCompletedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.completed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/completionPayload" } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["task.failed", "task.waiting_user"] } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/reasonPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.paused" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/taskPausedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.resumed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/taskResumedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.cancelled" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/cancellationPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "task.applied" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/appliedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "verification.completed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/verificationPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "change.updated" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/changePayload" } } }
    }
  ],
  "$defs": {
    "taskCreatedPayload": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stateChangedPayload": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/taskStatus"
        },
        "to": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/taskStatus"
        }
      },
      "additionalProperties": false
    },
    "planUpdatedPayload": {
      "type": "object",
      "required": ["plan"],
      "properties": {
        "plan": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/plan"
        }
      },
      "additionalProperties": false
    },
    "toolStartedPayload": {
      "type": "object",
      "required": ["toolName"],
      "properties": {
        "toolName": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/toolName"
        },
        "arguments": { "type": "object" }
      },
      "additionalProperties": false
    },
    "toolCompletedPayload": {
      "type": "object",
      "required": ["toolName"],
      "properties": {
        "toolName": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/toolName"
        },
        "result": true,
        "error": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["result"], "properties": { "result": true } },
        { "required": ["error"], "properties": { "error": true } }
      ],
      "additionalProperties": false
    },
    "reasonPayload": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "completionPayload": {
      "type": "object",
      "required": ["verification"],
      "properties": {
        "verification": {
          "type": "object",
          "required": ["command", "code"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "code": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "taskPausedPayload": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "const": "PAUSED" }
      },
      "additionalProperties": false
    },
    "taskResumedPayload": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["PLANNING", "EXECUTING", "VERIFYING"] }
      },
      "additionalProperties": false
    },
    "cancellationPayload": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "appliedPayload": {
      "type": "object",
      "required": ["changeCount"],
      "properties": {
        "changeCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "verificationPayload": {
      "type": "object",
      "required": ["verification"],
      "properties": {
        "verification": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/verificationResult"
        }
      },
      "additionalProperties": false
    },
    "changePayload": {
      "type": "object",
      "required": ["changeId", "decision"],
      "properties": {
        "changeId": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/id"
        },
        "decision": {
          "$ref": "https://codeharness.local/schemas/domain.schema.json#/$defs/changeDecision"
        }
      },
      "additionalProperties": false
    }
  }
}
