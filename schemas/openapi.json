  "components": {
    "schemas": {
      "health": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "codeharness-backend"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "projectCreate": {
        "type": "object",
        "required": ["name", "sourcePath"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "projectSummary": {
        "type": "object",
        "required": ["id", "name", "createdAt"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "$ref": "#/components/schemas/timestamp"
          }
        },
        "additionalProperties": false
      },
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "searchResult": {
        "type": "object",
        "required": ["path", "line", "preview"],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
