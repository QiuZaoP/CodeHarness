                    "type": "integer",
                    "minimum": 0
                  },
                  "PLANNING": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "EXECUTING": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "VERIFYING": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "READY_FOR_REVIEW": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "APPLIED": {
                    "type": "integer",
                    "minimum": 0
